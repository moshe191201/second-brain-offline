<View>
  <Style>
    .md-preview { background: #f8f9fa; padding: 16px; border-radius: 8px; max-height: 560px; overflow-y: auto; }
    .llm-box { background: #fff3cd; padding: 12px; border-left: 4px solid #ffc107; margin: 12px 0; }
    .sure { border-left-color: #198754; background: #d1e7dd; }
    .needs { border-left-color: #ffc107; background: #fff3cd; }
    .guessed { border-left-color: #dc3545; background: #f8d7da; }
  </Style>

  <Header value="Document — $filename" />

  <View style="display: flex; gap: 16px;">
    <View style="flex: 2;">
      <View className="md-preview">
        <HyperText name="text" value="$text_html" />
      </View>
    </View>
    <View style="flex: 1;">
      <View className="$confidence_class">
        <Header value="LLM: $llm_primary — $confidence_bucket" />
        <Text name="candidates" value="Candidates: $candidates" />
        <Text name="reasoning" value="Reasoning: $reasoning_brief" />
        <Text name="secondary" value="Secondary: $llm_secondary" />
        <Text name="relation" value="Relation: $relation_type" />
      </View>

      <Header value="Primary subdomain (single)" />
      <Choices name="primary" toName="text" choice="single" showInLine="true" required="true">
        <!-- Render Choices from taxonomy.yaml: one per subdomain -->
        <!-- Example placeholders — export_label_studio.py replaces these from taxonomy -->
        <Choice value="diabetes_monitoring" />
        <Choice value="prostate_screening" />
        <Choice value="nephrology" />
        <Choice value="genetic_risk" />
        <Choice value="cardiology" />
      </Choices>

      <Header value="Secondary subdomains (multi)" />
      <Choices name="secondary" toName="text" choice="multiple" showInLine="true">
        <Choice value="diabetes_monitoring" />
        <Choice value="prostate_screening" />
        <Choice value="nephrology" />
        <Choice value="genetic_risk" />
        <Choice value="cardiology" />
      </Choices>

      <Header value="Relation type" />
      <Choices name="relation" toName="text" choice="single" showInLine="true">
        <Choice value="none" />
        <Choice value="comparison" />
        <Choice value="relationship" />
        <Choice value="progression" />
      </Choices>

      <Header value="Notes" />
      <TextArea name="comment" toName="text"
        placeholder="Flag implicit term missing from glossary or bad definition — will patch glossary/taxonomy"
        rows="2" />
    </View>
  </View>
</View>
