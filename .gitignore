.obsidian/
.DS_Store
graphify-out/.graphify_*
__pycache__/
*.pyc
.qmd/*.sqlite*
.idea

# Build / docs output
dist/
build/
*.egg-info/
public/
site/

# Derived qmd index — example_vault/.qmd/index.yml IS committed.
**/.qmd/*.sqlite*

# Written by `vault upgrade` when a framework-owned file drifted.
**/.vault-framework-backup/

**/graphify-out/.graphify_*

# Offline docling models — selectable-text bundle (506 MB). Re-vendor via:
# python scripts/download_docling_models.py && python scripts/package_docling_offline_bundle.py
# Transfer once through the gap; distribute inside via NFS/S3.
/deps/docling-models/
/deps/tessdata/

# YAP Hebrew morphological analyzer — external dependency, not vendored.
# Install separately: see scripts/hebrew_yap_stemmer.py _find_yap_exe() for discovery.
# The binary is expected via YAP_DIR/yap.exe or on $PATH.
deps/yap/

# ---------------------------------------------------------------------------
# ingest-pipeline artifacts.
#
# These paths moved under ingest-pipeline/ when the pipeline became its own
# product. Any pattern containing an internal slash is anchored to the repo
# root, so the pre-move spellings (scripts/..., data/...) silently stopped
# matching -- which would have let `git add -A` in the air gap commit the whole
# converted corpus and ~76 MB of .NET publish output.
# ---------------------------------------------------------------------------

# OneNote offline - .NET build outputs (self-contained publish ~76MB, local only)
ingest-pipeline/scripts/OneNoteOffline/bin/
ingest-pipeline/scripts/OneNoteOffline/obj/
ingest-pipeline/scripts/OneNoteOffline/publish/

# Waived derived artifacts (not part of vault 3-layer model)
# ingest-pipeline/data/domain_terms/glossary.csv IS committed as a template
# (headers + example row), hence the negation below.
/ingest-pipeline/raw_md/
ingest-pipeline/data/domain_terms/*
!ingest-pipeline/data/domain_terms/glossary.csv
ingest-pipeline/data/hebrew_dict.json
ingest-pipeline/data/translations/
ingest-pipeline/data/review_queue/
.campaigns/
campaigns/
ingest-pipeline/data/hot_words.csv

# Large raw allowlist data (generated, not committed)
/ingest-pipeline/data/person_names/first_names_full.txt
/ingest-pipeline/data/person_names/first_names_raw.json
/ingest-pipeline/data/person_names/first_names_raw.csv
/ingest-pipeline/data/person_names/faker_first.json
